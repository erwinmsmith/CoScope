[Unit]
Description=CoScope Qdrant vector database
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 700 /var/lib/coscope/qdrant
ExecStartPre=-/usr/bin/docker rm -f coscope-qdrant
ExecStart=/usr/bin/docker run --rm --name coscope-qdrant --memory=768m --cpus=1.0 -p 127.0.0.1:6333:6333 -v /var/lib/coscope/qdrant:/qdrant/storage qdrant/qdrant:v1.18.3
ExecStop=/usr/bin/docker stop -t 30 coscope-qdrant
ExecStopPost=-/usr/bin/docker rm -f coscope-qdrant
Restart=on-failure
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
