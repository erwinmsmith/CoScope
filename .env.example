# ============================================================
# CoScope Runtime Environment Variables
# Copy this file to .env and fill in your values
# These are secrets, connection strings, and runtime overrides
# ============================================================

# --- API Keys ---
COSCOPE_OPENAI_API_KEY=your-openai-api-key-here
COSCOPE_ANTHROPIC_API_KEY=your-anthropic-api-key-here
COSCOPE_HUGGINGFACE_TOKEN=your-huggingface-token-here

# --- SiliconFlow API (OpenAI-compatible) ---
COSCOPE_SILICONFLOW_API_KEY=your-siliconflow-api-key-here
COSCOPE_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
COSCOPE_SILICONFLOW_MODEL=Qwen/Qwen3-32B

# --- Connection Strings ---
COSCOPE_VECTORSTORE_CONNECTION_STRING=./coscope_data/vectorstore
COSCOPE_REDIS_URL=redis://localhost:6379/0
COSCOPE_POSTGRES_URL=postgresql://user:password@localhost:5432/coscope
COSCOPE_QDRANT_URL=http://localhost:6333
COSCOPE_MILVUS_URL=http://localhost:19530

# --- LangGraph Checkpoint ---
COSCOPE_LANGGRAPH_CHECKPOINT_DIR=./coscope_data/checkpoints

# --- Evaluation Output ---
COSCOPE_EVAL_OUTPUT_DIR=./coscope_data/eval_results

# --- Runtime Overrides (override config.yaml values) ---
# Uncomment to override config.yaml settings
# COSCOPE_LOG_LEVEL=DEBUG
# COSCOPE_MAX_BATCH_SIZE=200
# COSCOPE_REQUEST_TIMEOUT=60
