# Copy this file to .env. The .env file is ignored by Git.
COSCOPE_RUNTIME_MODE=live

# DeepSeek OpenAI-compatible chat API.
DEEPSEEK_API_KEY=
COSCOPE_LLM_PROVIDER=deepseek
COSCOPE_LLM_MODEL=deepseek-v4-flash
COSCOPE_LLM_BASE_URL=https://api.deepseek.com
COSCOPE_LLM_TEMPERATURE=0.2
# Optional: omit to use the provider/model output limit.
# COSCOPE_LLM_MAX_TOKENS=8192
COSCOPE_LLM_TIMEOUT_SECONDS=60

# Local CPU embedding through FastEmbed's quantized ONNX backend.
COSCOPE_EMBEDDING_PROVIDER=fastembed
COSCOPE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COSCOPE_EMBEDDING_DIMENSION=384
COSCOPE_EMBEDDING_CACHE_DIR=fastembed_cache
COSCOPE_EMBEDDING_THREADS=2
COSCOPE_EMBEDDING_BATCH_SIZE=32
COSCOPE_EMBEDDING_RESULT_CACHE_SIZE=4096
# Set true in production after the model has been downloaded once.
COSCOPE_EMBEDDING_LOCAL_FILES_ONLY=false
COSCOPE_EMBEDDING_TIMEOUT_SECONDS=60

# Retrieval grouping and shared first-stage retrieval.
COSCOPE_MEDOID_THRESHOLD=0.90
COSCOPE_MIN_PAIRWISE_SIMILARITY=0.85
COSCOPE_MAX_GROUP_SIZE=16
COSCOPE_SHARED_CANDIDATE_K=50

# Remote alternatives:
# DASHSCOPE_API_KEY=
# COSCOPE_EMBEDDING_PROVIDER=dashscope
# COSCOPE_EMBEDDING_MODEL=text-embedding-v3
# COSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# COSCOPE_EMBEDDING_DIMENSION=1024
#
# ZHIPU_API_KEY=
# COSCOPE_EMBEDDING_PROVIDER=zhipu
# COSCOPE_EMBEDDING_MODEL=embedding-3
# COSCOPE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# COSCOPE_EMBEDDING_DIMENSION=1024

COSCOPE_LOG_LEVEL=INFO

# Cloud-only paths. Keep actual values and credentials in
# /etc/coscope/coscope.env, never in this repository.
# COSCOPE_ENV_FILE=/etc/coscope/coscope.env
# COSCOPE_DATA_ROOT=/var/lib/coscope/data
# COSCOPE_RUN_ROOT=/var/lib/coscope/runs/factorial-local-bge-v1
# COSCOPE_EVALPLUS_MEMORY=2g
